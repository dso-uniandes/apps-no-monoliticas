        {
          "name": "GET Partner Request Status (rejected)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 5000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('status REJECTED', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('REJECTED');",
                  "    pm.expect(body.work).to.eql(null);",
                  "});",
                  "pm.test('sin matching', function () {",
                  "    var steps = pm.response.json().steps.map(function (s) { return s.step; });",
                  "    pm.expect(steps).to.not.include('WORK_CREATED');",
                  "    pm.expect(steps).to.not.include('MATCHING_COMPLETED');",
                  "    pm.expect(steps).to.not.include('MATCHING_FAILED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bff_url}}/api/v1/partner-requests/{{rejected_external_reference}}"
