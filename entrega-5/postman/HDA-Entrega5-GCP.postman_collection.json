            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('guarda compensation_external_reference', function () {",
                  "    var body = pm.response.json();",
                  "    pm.environment.set('compensation_external_reference', body.external_reference);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partner_id\": \"partner-demo\",\n  \"payload\": {\n    \"reference\": \"{{compensation_ref}}\",\n    \"municipality\": \"Bogota\",\n    \"country_code\": \"CO\",\n    \"service_type\": \"HOME_REPAIR\"\n  }\n}"
            },
            "url": "{{bff_url}}/api/v1/partner-requests"
          }
        },
        {
          "name": "GET Partner Request Status (compensation)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(function () {}, 5000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('status COMPENSATED', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('COMPENSATED');",
                  "});",
                  "pm.test('work CANCELLED', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.work).to.be.ok;",
                  "    pm.expect(body.work.status).to.eql('CANCELLED');",
                  "});",
                  "pm.test('pasos de compensacion', function () {",
                  "    var steps = pm.response.json().steps.map(function (s) { return s.step; });",
                  "    pm.expect(steps).to.include('MATCHING_FAILED');",
                  "    pm.expect(steps).to.include('WORK_CANCELLED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{bff_url}}/api/v1/partner-requests/{{compensation_external_reference}}"
          }
        }
      ]
    },
